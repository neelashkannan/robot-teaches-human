<mujoco model="scene_lab">
    <!-- Workbench scene for the teacher hand. Not part of the upstream Pollen files.
         The hand is clamped upright on a short forearm post, on a matte bench in front of a wall,
         lit by a key and a fill light with soft shadows, so it reads as a real object. -->
    <include file="robot.xml" />

    <visual>
        <headlight diffuse="0.25 0.25 0.25" ambient="0.35 0.35 0.38" specular="0 0 0" />
        <quality shadowsize="4096" offsamples="8" />
        <global offwidth="1280" offheight="1280" />
        <rgba haze="0.55 0.58 0.62 1" />
        <map znear="0.01" zfar="4" shadowclip="1.2" haze="0.0" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.78 0.80 0.84" rgb2="0.38 0.40 0.45" width="512" height="1024" />
        <texture name="bench_tex" type="2d" builtin="flat" mark="random" random="0.03"
            rgb1="0.34 0.31 0.28" rgb2="0.34 0.31 0.28" markrgb="0.45 0.41 0.37" width="512" height="512" />
        <texture name="wall_tex" type="2d" builtin="flat" mark="random" random="0.015"
            rgb1="0.80 0.80 0.79" rgb2="0.80 0.80 0.79" markrgb="0.86 0.86 0.85" width="512" height="512" />
        <material name="bench" texture="bench_tex" texuniform="true" texrepeat="3 3" specular="0.08" shininess="0.1" reflectance="0.04" />
        <material name="wall" texture="wall_tex" texuniform="true" texrepeat="2 2" specular="0.0" />
        <material name="post_metal" rgba="0.62 0.64 0.67 1" specular="0.6" shininess="0.5" reflectance="0.1" />
        <material name="clamp_dark" rgba="0.14 0.15 0.17 1" specular="0.3" shininess="0.3" />
    </asset>

    <worldbody>
        <light name="key" pos="0.35 -0.45 0.75" dir="-0.4 0.55 -0.75" directional="false" castshadow="true"
            diffuse="0.85 0.82 0.78" specular="0.15 0.15 0.15" cutoff="55" exponent="4" />
        <light name="fill" pos="-0.45 0.35 0.45" dir="0.6 -0.4 -0.5" directional="false" castshadow="false"
            diffuse="0.28 0.30 0.34" specular="0 0 0" />
        <light name="rim" pos="0.1 0.5 0.4" dir="-0.1 -0.8 -0.35" directional="false" castshadow="false"
            diffuse="0.22 0.22 0.25" specular="0 0 0" />

        <!-- Bench top (box, not a plane, so Teacher keeps it visible) and a back wall. -->
        <geom name="bench" type="box" pos="0 0 -0.285" size="0.9 0.6 0.015" material="bench" friction="0.8 0.01 0.001" />
        <geom name="wall" type="box" pos="-0.55 0 0.35" size="0.01 1.0 0.7" material="wall" contype="0" conaffinity="0" />

        <!-- Forearm post and clamp plate under the wrist interface (wrist is at the origin). -->
        <geom name="forearm" type="cylinder" fromto="0 0 -0.012 0 0 -0.26" size="0.027" material="post_metal" contype="0" conaffinity="0" />
        <geom name="cuff" type="cylinder" fromto="0 0 -0.012 0 0 -0.045" size="0.031" material="clamp_dark" contype="0" conaffinity="0" />
        <geom name="clamp_plate" type="cylinder" fromto="0 0 -0.268 0 0 -0.27" size="0.075" material="clamp_dark" contype="0" conaffinity="0" />
        <geom name="clamp_boss" type="cylinder" fromto="0 0 -0.268 0 0 -0.255" size="0.04" material="clamp_dark" contype="0" conaffinity="0" />

        <!-- Loose objects that obey gravity and contacts: they drop onto the bench when the scene
             loads and can be knocked by the hand. -->
        <body name="ball" pos="0.14 -0.11 -0.05">
            <freejoint name="ball_free" />
            <geom name="ball_geom" type="sphere" size="0.022" mass="0.02" rgba="0.86 0.30 0.22 1"
                friction="0.7 0.005 0.0005" solref="0.004 1" solimp="0.95 0.99 0.001" />
        </body>
        <body name="cube" pos="0.15 0.07 -0.10" euler="0 0 25">
            <freejoint name="cube_free" />
            <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.24 0.46 0.74 1"
                friction="0.8 0.005 0.0005" solref="0.004 1" />
        </body>
        <body name="block" pos="0.06 -0.17 -0.18" euler="0 0 -40">
            <freejoint name="block_free" />
            <geom name="block_geom" type="box" size="0.035 0.014 0.012" mass="0.025" rgba="0.90 0.78 0.36 1"
                friction="0.8 0.005 0.0005" solref="0.004 1" />
        </body>
    </worldbody>
</mujoco>
